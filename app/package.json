{
  "name": "eloquent-coach",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "productName": "Eloquent Coach",
  "description": "Eloquent Coach: make every word land. Local, real-time meeting coaching (Electron + React UI)",
  "type": "module",
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.eloquentcoach.app",
    "productName": "Eloquent Coach",
    "mac": { "icon": "build/icon.icns", "category": "public.app-category.productivity" },
    "win": { "icon": "build/icon.png" },
    "linux": { "icon": "build/icon.png" }
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "node tests/hud.test.ts && node tests/prompter.test.ts",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true,
    "esbuild": true,
    "fsevents": true
  },
  "overrides": {
    "minimatch@^9.0.0": "^11.0.3",
    "minimatch@^10.0.0": "^11.0.3"
  }
}
